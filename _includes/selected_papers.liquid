<div class="publications selected-publications">
  {% for group in site.data.selected_publications %}
    <section class="publication-group" aria-labelledby="publications-{{ group.id }}">
      <h3 id="publications-{{ group.id }}">{{ group.title | escape }}</h3>
      {% for paper_key in group.papers %}
        {% bibliography --group_by none --query @*[key={{ paper_key }}]* %}
      {% endfor %}
    </section>
  {% endfor %}
</div>
