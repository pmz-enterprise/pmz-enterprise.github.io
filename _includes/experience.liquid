<section class="experience" aria-labelledby="experience-heading">
  <h2 id="experience-heading">research experience</h2>
  <ul class="list-unstyled">
    {% for experience in site.data.experience %}
      <li class="experience-entry mb-3">
        {% if experience.logo %}
          <div class="experience-logo">
            <img src="{{ experience.logo | relative_url }}" alt="{{ experience.institution | escape }} logo" width="128" height="80" loading="lazy">
          </div>
        {% endif %}
        <div class="experience-details">
          <div class="d-flex justify-content-between flex-wrap">
            <strong>{{ experience.institution | escape }}</strong>
            <span class="text-muted">{{ experience.period | escape }}</span>
          </div>
          <div>
            {{ experience.role | escape }}{% if experience.team %} &middot; {{ experience.team | escape }}{% endif %}
          </div>
          {% if experience.description %}
            <p class="mt-1 mb-0">{{ experience.description | escape }}</p>
          {% endif %}
        </div>
      </li>
    {% endfor %}
  </ul>
</section>
